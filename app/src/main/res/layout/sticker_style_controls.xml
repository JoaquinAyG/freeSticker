<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/removeBgSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remove_background" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/shape"
        android:textAppearance="?attr/textAppearanceTitleSmall" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/shapeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:selectionRequired="true"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/shapeSquare"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/shape_square" />

        <com.google.android.material.chip.Chip
            android:id="@+id/shapeRounded"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shape_rounded" />

        <com.google.android.material.chip.Chip
            android:id="@+id/shapeCircle"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/shape_circle" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/borderSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/white_outline" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/caption_hint">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/captionInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:maxLength="40"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
